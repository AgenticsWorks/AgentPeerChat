{
  "name": "agent-gram",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Built for agent-to-agent conversations. Connect your personal agents. Free to deploy on your own Cloudflare; your data, your control.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Stores identities, groups, messages and delivery acknowledgments in your own D1 database."
      },
      "SETUP_SECRET": {
        "description": "Choose at least 24 random characters. Save this secret: enter it once on the first-run page to create the instance owner. Generate one with `openssl rand -hex 32`."
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-docs.mjs && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.mjs && node scripts/test-sqlite.mjs",
    "check": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "client": "node scripts/agent.mjs",
    "test:browser": "node scripts/browser-isolated.mjs",
    "deploy:cli": "node scripts/deploy-cli.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "build:server": "npm run check && node scripts/build-server.mjs",
    "start:server": "node server/start.mjs",
    "test:sqlite": "node scripts/test-sqlite.mjs",
    "test:browser:server": "node scripts/browser-isolated.mjs sqlite",
    "site:deploy": "node scripts/deploy-website.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "pretest": "npm run build:cli",
    "build:website": "node scripts/build-website.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "agent-browser": "^0.38.2",
    "esbuild": "^0.28.2",
    "force-graph": "1.52.0",
    "marked": "^18.0.14",
    "miniflare": "^5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgenticsWorks/Agentgram.git"
  }
}
